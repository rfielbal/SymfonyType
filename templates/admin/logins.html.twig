{% extends 'base.html.twig' %}
{% block title %}Connexions · Administration
{% endblock %}
{% block body %}
	<div class="actions">
		<a class="btn secondary" href="{{ path('admin_users') }}">Retour aux comptes</a>
		<h1>Connexions de
			{{ user.prenom }}
			{{ user.nom }}</h1>
	</div>
	<div class="card">
		<p>{{ user.email }}</p>
		<table>
			<thead>
				<tr>
					<th>Date</th>
					<th>Heure</th>
				</tr>
			</thead>
			<tbody>
				{% for login in logins %}
					<tr>
						<td>{{ login.dateHeure|date('d/m/Y', 'Europe/Paris') }}</td>
						<td>{{ login.dateHeure|date('H:i:s', 'Europe/Paris') }}</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="2">Aucune connexion enregistrée.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
