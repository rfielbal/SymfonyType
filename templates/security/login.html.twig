{% extends 'base.html.twig' %}
{% block title %}Connexion · Gestion des accès{% endblock %}
{% block body %}
<section class="card" style="max-width:520px;margin:3rem auto">
    <h1>Connexion</h1>
    {% if error %}<div class="flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post">
        <label for="email">Adresse e-mail</label>
        <input id="email" type="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
        <label for="password">Mot de passe</label>
        <input id="password" type="password" name="password" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <p><button type="submit">Se connecter</button></p>
    </form>
    <p class="muted">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
</section>
{% endblock %}
