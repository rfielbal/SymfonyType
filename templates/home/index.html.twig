{% extends 'base.html.twig' %}
{% block title %}Accueil · Gestion des accès{% endblock %}
{% block body %}
<section class="home-intro" aria-labelledby="home-title">
    <div class="home-copy">
        <p class="eyebrow"><span></span>Votre espace personnel</p>
        {% if app.user %}
            <h1 id="home-title">Bonjour,<br><span>{{ app.user.prenom }}.</span></h1>
            <p class="intro-text">Retrouvez vos informations et les paramètres de votre compte, au même endroit.</p>
            <a class="text-link" href="{{ path('app_profile') }}">Consulter mon profil <span aria-hidden="true">↗</span></a>
        {% else %}
            <h1 id="home-title">Un compte.<br><span>Votre espace.</span></h1>
            <p class="intro-text">Accédez à votre profil et gérez votre compte en quelques instants.</p>
            <p class="home-note">Un accès personnel, des droits adaptés à votre rôle.</p>
        {% endif %}
    </div>
    <aside class="entry-panel" aria-label="Accéder à votre espace">
        <div class="entry-panel-top"><span class="eyebrow">Gestion des accès</span><span class="panel-symbol" aria-hidden="true">↗</span></div>
        <div class="entry-panel-body">
            <span class="entry-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="8" y="14" width="16" height="13" rx="3"/><path d="M11 14V10a5 5 0 0 1 10 0v4M16 19v3"/></svg></span>
            {% if app.user %}
                <h2>Votre compte</h2><p>{{ app.user.email }}</p>
                <a class="btn wide" href="{{ path('app_profile') }}">Ouvrir mon profil <span aria-hidden="true">→</span></a>
                {% if is_granted('ROLE_ADMIN') %}<a class="panel-secondary" href="{{ path('admin_users') }}">Gérer les utilisateurs <span aria-hidden="true">↗</span></a>{% endif %}
            {% else %}
                <h2>Heureux de vous retrouver.</h2><p>Connectez-vous pour accéder à votre compte.</p>
                <a class="btn wide" href="{{ path('app_login') }}">Se connecter <span aria-hidden="true">→</span></a>
                <div class="panel-divider"><span>Première visite ?</span></div>
                <a class="panel-secondary" href="{{ path('app_register') }}">Créer un compte <span aria-hidden="true">↗</span></a>
            {% endif %}
        </div>
    </aside>
</section>
<section class="overview" aria-label="Dans votre espace">
    <p class="eyebrow overview-label">Dans votre espace</p>
    <div class="overview-grid">
        <article><span class="section-number">01</span><div><h2>Vos informations</h2><p>Retrouvez les informations associées à votre compte.</p></div></article>
        <article><span class="section-number">02</span><div><h2>Votre mot de passe</h2><p>Modifiez votre mot de passe depuis votre profil.</p></div></article>
        <article><span class="section-number">03</span><div><h2>Les habilitations</h2><p>L’administration gère les comptes et leurs droits d’accès.</p></div></article>
    </div>
</section>
{% endblock %}
