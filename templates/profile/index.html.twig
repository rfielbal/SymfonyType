{% extends 'base.html.twig' %}
{% block title %}Mon profil · Gestion des accès{% endblock %}
{% block body %}
<h1>Mon profil</h1>
<section class="card">
    <div class="actions"><strong>{{ app.user.prenom }} {{ app.user.nom }}</strong><span class="muted">{{ app.user.email }}</span></div>
    <p>{{ app.user.adrRue }}, {{ app.user.cp }} {{ app.user.ville }}</p>
    <p class="muted">Inscription le {{ app.user.dateInscription|date('d/m/Y') }} · {{ app.user.isActif ? 'Compte actif' : 'Compte suspendu' }}</p>
</section>
<section class="card" style="max-width:650px">
    <h2>Modifier le mot de passe</h2>
    <p class="muted">Un ancien mot de passe ne pourra plus être réutilisé. Le mot de passe actuel est demandé pour confirmer le changement.</p>
    {{ form_start(changePasswordForm) }}
        {{ form_errors(changePasswordForm) }}
        {{ form_row(changePasswordForm.oldPassword) }}
        {{ form_row(changePasswordForm.newPassword) }}
        <button type="submit">Mettre à jour</button>
    {{ form_end(changePasswordForm) }}
</section>
{% endblock %}
